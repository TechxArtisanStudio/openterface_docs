---
import BaseLayout from './BaseLayout.astro';
import DocEmbeds from '../components/DocEmbeds.astro';
import DocPageNav from '../components/DocPageNav.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsTOC from '../components/DocsTOC.astro';
import FaqFilterChips from '../components/FaqFilterChips.astro';
import LocaleFallbackBanner from '../components/LocaleFallbackBanner.astro';
import { sidebarForSlug, sidebarNavLabel } from '../config/sidebar';
import { getAdjacentPages, getDocAlternates, pageDescription, pageTitle, type DocPage } from '../lib/docs';

interface Props {
  page: DocPage;
}

const { page } = Astro.props;
const { locale, slug, href, html, headings } = page;
const sidebar = sidebarForSlug(locale, slug);
const alternates = getDocAlternates(slug);
const { prev, next } = getAdjacentPages(slug, locale);
const title = pageTitle(page);

function navLabel(doc: DocPage): string {
  return sidebarNavLabel(doc.slug, locale) ?? pageTitle(doc);
}

const prevLink = prev ? { href: prev.href, label: navLabel(prev) } : undefined;
const nextLink = next ? { href: next.href, label: navLabel(next) } : undefined;
const hasH1 = /<h1[\s>]/i.test(html);
---

<BaseLayout
  locale={locale}
  title={title}
  description={pageDescription(page)}
  canonicalPath={href}
  hreflangAlternates={alternates}
>
  <div class="mx-auto max-w-7xl px-4 lg:px-6">
    <LocaleFallbackBanner />
    <div class="flex flex-col gap-0 lg:flex-row lg:items-start">
    {
      sidebar && (
        <DocsSidebar locale={locale} items={sidebar} slug={slug} currentPath={href} />
      )
    }

    <article class="min-w-0 flex-1 py-6 lg:py-8 xl:max-w-3xl">
      <div class="prose-docs mx-auto max-w-none px-0 lg:px-6">
        {
          slug === 'faq' && (
            <FaqFilterChips
              locale={locale}
              basePath={href}
              activeProduct={Astro.url.searchParams.get('product')}
              activeApp={Astro.url.searchParams.get('app')}
              activeTopic={Astro.url.searchParams.get('topic')}
            />
          )
        }
        {!hasH1 && <h1>{title}</h1>}
        <div set:html={html} />
      </div>
      <DocPageNav prev={prevLink} next={nextLink} />
    </article>

    <DocsTOC locale={locale} headings={headings} />
    </div>
  </div>
  <DocEmbeds />
  {slug === 'faq' && (
    <script>
      import { initFaqFilter } from '../scripts/faq-filter';
      initFaqFilter();
    </script>
  )}
</BaseLayout>
