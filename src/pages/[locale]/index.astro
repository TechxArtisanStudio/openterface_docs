---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectDocPages, getDocPage, getDocAlternates, pageTitle } from '../../lib/docs';
import { DEFAULT_LOCALE, isSiteLocale, type SiteLocale } from '../../lib/locale';

export function getStaticPaths() {
  return collectDocPages()
    .filter((p) => p.locale !== DEFAULT_LOCALE && p.slug === 'index')
    .map((p) => ({
      params: { locale: p.locale },
      props: { slug: 'index' as const, locale: p.locale },
    }));
}

const { slug, locale } = Astro.props;

if (!isSiteLocale(locale) || locale === DEFAULT_LOCALE) {
  return Astro.redirect('/');
}

const doc = getDocPage(slug, locale);
if (!doc) {
  return Astro.redirect('/404/');
}
---

<BaseLayout
  locale={locale}
  title={pageTitle(doc)}
  description={doc.frontmatter.description}
  canonicalPath={doc.href}
  hreflangAlternates={getDocAlternates(slug)}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="prose-docs" set:html={doc.html} />
  </div>
</BaseLayout>
