---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { collectDocPages, getDocPage } from '../../lib/docs';
import { DEFAULT_LOCALE, isSiteLocale } from '../../lib/locale';

export function getStaticPaths() {
  return collectDocPages()
    .filter((p) => p.locale !== DEFAULT_LOCALE && p.slug !== 'index')
    .map((p) => ({
      params: { locale: p.locale, slug: p.slug },
      props: { slug: p.slug, locale: p.locale },
    }));
}

const { slug, locale } = Astro.props;

if (!isSiteLocale(locale) || locale === DEFAULT_LOCALE) {
  return Astro.redirect('/');
}

const doc = getDocPage(slug, locale);
if (!doc) {
  return Astro.redirect('/404/');
}
---

<DocsLayout page={doc} />
