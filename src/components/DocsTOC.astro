---
import type { DocHeading } from '../lib/docs';
import { t } from '../i18n/ui';
import type { SiteLocale } from '../lib/locale';

interface Props {
  locale: SiteLocale;
  headings: DocHeading[];
}

const { locale, headings } = Astro.props;
const ui = t(locale);
const tocHeadings = headings.filter((h) => h.depth <= 3);
---

{
  tocHeadings.length > 0 && (
    <aside
      class="docs-toc sticky top-[4.5rem] hidden max-h-[calc(100vh-5rem)] w-48 shrink-0 self-start overflow-y-auto pb-8 pl-4 pt-6 xl:block"
      aria-label={ui.docs.onThisPage}
    >
      <p class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">{ui.docs.onThisPage}</p>
      <nav class="min-w-0 space-y-1">
        {
          tocHeadings.map((heading) => (
            <a
              href={`#${heading.id}`}
              title={heading.text}
              class:list={[
                'toc-link',
                heading.depth === 3 && 'pl-5 text-xs',
              ]}
            >
              {heading.text}
            </a>
          ))
        }
      </nav>
    </aside>
  )
}
