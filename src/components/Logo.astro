---
interface Props {
  variant?: 'default' | 'onPrimary' | 'onLight';
  class?: string;
  /** Combined site brand mark (header). Falls back to local wordmark when omitted. */
  brandSrc?: string;
  alt?: string;
}

const { variant = 'default', class: className = '', brandSrc, alt = 'Openterface' } = Astro.props;
const src = brandSrc ?? `${import.meta.env.BASE_URL}images/openterface.svg`;
const invertForHeader = !brandSrc && variant === 'onPrimary';
const darkBrandOnLight = Boolean(brandSrc) && variant === 'onLight';
---

<img
  src={src}
  alt={alt}
  class:list={[
    'h-8 w-auto max-w-[180px]',
    invertForHeader && 'brightness-0 invert',
    darkBrandOnLight && 'logo-on-light',
    className,
  ]}
  width="180"
  height="27"
  loading="eager"
  decoding="async"
/>
