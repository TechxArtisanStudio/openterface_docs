---
/** Client behavior for legacy MkDocs embeds rendered inside doc prose. */
---

<script>
  function preloadSlideshowImages(images) {
    images.forEach((img) => {
      if (!img.src || img.complete) return;
      const preload = new Image();
      preload.src = img.src;
    });
  }

  function whenImageReady(img, callback) {
    if (img.complete && img.naturalWidth > 0) {
      callback();
      return;
    }
    const onReady = () => {
      img.removeEventListener('load', onReady);
      img.removeEventListener('error', onReady);
      callback();
    };
    img.addEventListener('load', onReady);
    img.addEventListener('error', onReady);
  }

  function initDocSlideshows() {
    document.querySelectorAll('[data-doc-slideshow]').forEach((root) => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const images = Array.from(root.querySelectorAll('.doc-slideshow__image'));
      const dots = Array.from(root.querySelectorAll('.doc-slideshow__dot'));
      const prev = root.querySelector('.doc-slideshow__prev');
      const next = root.querySelector('.doc-slideshow__next');
      if (images.length <= 1) return;

      preloadSlideshowImages(images);

      let current = 0;
      let timer;

      function show(index) {
        current = index;
        images.forEach((img, i) => {
          const active = i === index;
          img.classList.toggle('is-active', active);
          img.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      }

      function advance(delta) {
        const nextIndex = (current + delta + images.length) % images.length;
        const target = images[nextIndex];
        if (!target) return;
        whenImageReady(target, () => show(nextIndex));
      }

      prev?.addEventListener('click', () => advance(-1));
      next?.addEventListener('click', () => advance(1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => advance(i - current)));

      timer = window.setInterval(() => advance(1), 5000);
      root.addEventListener('mouseenter', () => window.clearInterval(timer));
      root.addEventListener('mouseleave', () => {
        timer = window.setInterval(() => advance(1), 5000);
      });
    });
  }

  function initSubscribeForms() {
    document.querySelectorAll('form.subscribe-form').forEach((form) => {
      if (form.dataset.subscribeBound === 'true') return;
      form.dataset.subscribeBound = 'true';

      const endpoint = form.dataset.subscribeEndpoint;
      const submitBtn = form.querySelector('.subscribe-submit, .doc-product-signup__submit');
      const statusEl = form.querySelector('[data-status]');
      if (!endpoint || !submitBtn) return;

      const defaultLabel = submitBtn.dataset.defaultLabel ?? submitBtn.textContent ?? 'Subscribe';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const email = String(data.get('email') ?? '').trim();
        const name = String(data.get('name') ?? '').trim();
        if (!email) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing…';
        statusEl?.classList.add('hidden');

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, name }),
          });
          const result = await response.json();
          if (result?.success) {
            submitBtn.textContent = 'Subscribed — thank you!';
            form.reset();
            if (statusEl) {
              statusEl.textContent = 'Subscribed — thank you!';
              statusEl.dataset.state = 'success';
              statusEl.classList.remove('hidden');
            }
            window.setTimeout(() => {
              submitBtn.textContent = defaultLabel;
              submitBtn.disabled = false;
              statusEl?.classList.add('hidden');
            }, 4000);
          } else {
            throw new Error('failed');
          }
        } catch {
          submitBtn.textContent = 'Something went wrong';
          submitBtn.disabled = false;
          if (statusEl) {
            statusEl.textContent = 'Something went wrong. Please try again.';
            statusEl.dataset.state = 'error';
            statusEl.classList.remove('hidden');
          }
        }
      });
    });
  }

  function loadTwitterWidgets() {
    return new Promise((resolve) => {
      if (window.twttr?.widgets) {
        resolve(window.twttr);
        return;
      }

      const existing = document.querySelector('script[data-twitter-widgets]');
      if (existing) {
        existing.addEventListener('load', () => resolve(window.twttr));
        return;
      }

      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.dataset.twitterWidgets = 'true';
      script.onload = () => resolve(window.twttr);
      document.head.appendChild(script);
    });
  }

  function activateSocialPost(item) {
    item.classList.remove('loading');
    item.classList.add('loaded');
  }

  function initSocialPosts() {
    const container = document.querySelector('.doc-social-posts');
    if (!container || container.dataset.initialized) return;
    container.dataset.initialized = 'true';

    const items = Array.from(container.querySelectorAll('.doc-social-post__item[data-lazy="true"]'));
    if (!items.length) return;

    const renderWidgets = () => {
      loadTwitterWidgets().then((twttr) => {
        if (twttr?.widgets?.load) {
          twttr.widgets.load(container);
        }
      });
    };

    if (!('IntersectionObserver' in window)) {
      items.forEach(activateSocialPost);
      renderWidgets();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          activateSocialPost(entry.target);
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '80px 0px', threshold: 0.05 },
    );

    items.forEach((item) => observer.observe(item));
    renderWidgets();

    window.setTimeout(() => {
      items.forEach(activateSocialPost);
      renderWidgets();
    }, 2500);
  }

  async function initMermaid() {
    const nodes = Array.from(document.querySelectorAll('pre.mermaid:not([data-processed])'));
    if (!nodes.length) return;

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        fontFamily: '"Roboto", system-ui, sans-serif',
        fontSize: '14px',
        primaryColor: '#f5ebe9',
        primaryTextColor: '#373737',
        primaryBorderColor: '#ff6e42',
        secondaryColor: '#fafafa',
        secondaryTextColor: '#373737',
        secondaryBorderColor: '#e5e7eb',
        tertiaryColor: '#ffffff',
        tertiaryTextColor: '#373737',
        tertiaryBorderColor: '#e5e7eb',
        lineColor: '#5c5c5c',
        textColor: '#373737',
        mainBkg: '#ffffff',
        nodeBorder: '#ff6e42',
        clusterBkg: '#fafafa',
        titleColor: '#373737',
        edgeLabelBackground: '#ffffff',
        background: '#ffffff',
      },
      flowchart: {
        htmlLabels: true,
        curve: 'basis',
        padding: 20,
      },
    });
    await mermaid.run({ nodes });
  }

  function initDocEmbeds() {
    initDocSlideshows();
    initSubscribeForms();
    initSocialPosts();
    void initMermaid();
  }

  initDocEmbeds();
  document.addEventListener('astro:page-load', initDocEmbeds);
</script>
