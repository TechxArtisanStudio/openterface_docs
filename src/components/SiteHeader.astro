---
import { docsNav, marketingHost, siteConfig } from '../config/site';
import { activeDocsTab } from '../lib/docs-header-nav';
import { localizedPath, type SiteLocale } from '../lib/locale';
import { docsEcosystemLinks, t } from '../i18n/ui';
import DocsHeaderBrand from './DocsHeaderBrand.astro';
import DocsSearch from './DocsSearch.astro';
import NavDropdown from './NavDropdown.astro';
import NavLinkWithBadge from './NavLinkWithBadge.astro';

interface Props {
  locale: SiteLocale;
  currentPath: string;
  currentSearch?: string;
  searchIndex: { title: string; href: string; excerpt: string }[];
}

const { locale, currentPath, currentSearch = '', searchIndex } = Astro.props;
const ui = t(locale);
const nav = docsNav(locale);
const ecosystemLinks = docsEcosystemLinks(locale);
const homeHref = localizedPath(locale);
const marketingBackHref = marketingHost(locale);
const activeTab = activeDocsTab(currentPath);
---

<header class="site-header site-header--docs sticky top-0 z-50">
  <div class="site-header__inner site-header__inner--docs">
    <div class="site-header__start site-header__start--docs">
      <DocsHeaderBrand
        locale={locale}
        docsHomeHref={homeHref}
        backAriaLabel={ui.nav.backToSiteAria}
        opMarkSrc={siteConfig.headerOpMark}
        docsMarkSrc={siteConfig.headerDocsMark}
        docsMarkAlt={ui.nav.docsBadge}
      />
    </div>

    <nav class="site-header__nav" aria-label="Documentation sections">
      {
        nav.map((item) =>
          item.children?.length ? (
            <NavDropdown
              label={item.label}
              children={item.children}
              active={activeTab === item.tabId}
            />
          ) : (
            <a
              href={item.href}
              class:list={[
                'site-header__nav-link',
                activeTab === item.tabId && 'site-header__nav-link--active',
              ]}
              aria-current={activeTab === item.tabId ? 'page' : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="site-header__toolbar">
      <DocsSearch locale={locale} searchIndex={searchIndex} class="hidden min-w-0 sm:block sm:max-w-xs lg:max-w-sm xl:max-w-md" />

      <details class="mobile-nav relative xl:hidden">
        <summary
          class="site-header__icon-btn mobile-nav-toggle"
          aria-label="Open menu"
        >
          <svg class="mobile-nav-icon-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="mobile-nav-icon-close hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <div class="mobile-nav-backdrop fixed inset-0 top-[var(--site-header-height)] z-40 bg-black/45"></div>

        <nav
          class="mobile-nav-panel fixed inset-x-0 top-[var(--site-header-height)] z-50 border-b border-gray-200 bg-white shadow-lg"
          aria-label="Mobile navigation"
        >
          <div class="mx-auto max-h-[min(75vh,36rem)] max-w-7xl overflow-y-auto overscroll-contain px-3 py-2 sm:px-4 sm:py-3">
            <div class="mb-3 sm:hidden">
              <DocsSearch locale={locale} searchIndex={searchIndex} />
            </div>

            <a
              href={marketingBackHref}
              class="mobile-nav-link mobile-nav-link--back"
              data-analytics-event="surface_exit_docs"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mr-2 h-4 w-4 shrink-0" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
              </svg>
              {ui.nav.backToSite}
            </a>

            <div class="mobile-nav-section">
              <p class="mobile-nav-section-label">{ui.mobile.sections}</p>
              <div class="mobile-nav-section-links">
                {
                  nav.map((item) =>
                    item.children?.length ? (
                      <div class="mobile-nav-subsection">
                        <p class="mobile-nav-subsection-label">{item.label}</p>
                        {
                          item.children.map((child) => (
                            <a
                              href={child.href}
                              class:list={[
                                'mobile-nav-link',
                                'mobile-nav-link--child',
                                currentPath === child.href && 'mobile-nav-link--active',
                              ]}
                              aria-current={currentPath === child.href ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          ))
                        }
                      </div>
                    ) : (
                      <a
                        href={item.href}
                        class:list={[
                          'mobile-nav-link',
                          activeTab === item.tabId && 'mobile-nav-link--active',
                        ]}
                        aria-current={activeTab === item.tabId ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    ),
                  )
                }
              </div>
            </div>

            {
              ecosystemLinks.length > 0 && (
                <div class="mobile-nav-section pb-1">
                  <p class="mobile-nav-section-label">{ui.mobile.ecosystem}</p>
                  <div class="mobile-nav-section-links">
                    {
                      ecosystemLinks.map((item) =>
                        item.badge || item.external ? (
                          <NavLinkWithBadge
                            href={item.href}
                            label={item.label}
                            badge={item.badge}
                            external={item.external}
                            variant="mobile"
                          />
                        ) : (
                          <a href={item.href} class="mobile-nav-link">
                            {item.label}
                          </a>
                        ),
                      )
                    }
                  </div>
                </div>
              )
            }
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  function closeAllNavDropdowns(except?: Element | null) {
    document.querySelectorAll('header .nav-dropdown[open]').forEach((dropdown) => {
      if (except && dropdown === except) return;
      if (dropdown instanceof HTMLDetailsElement) dropdown.open = false;
    });
  }

  function initNavDropdownHover() {
    document.querySelectorAll<HTMLDetailsElement>('header .nav-dropdown').forEach((dropdown) => {
      if (dropdown.dataset.hoverInit) return;
      dropdown.dataset.hoverInit = 'true';

      let openTimer: ReturnType<typeof setTimeout> | undefined;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;

      const scheduleOpen = () => {
        clearTimeout(closeTimer);
        openTimer = setTimeout(() => {
          closeAllNavDropdowns(dropdown);
          dropdown.open = true;
        }, 80);
      };

      const scheduleClose = () => {
        clearTimeout(openTimer);
        closeTimer = setTimeout(() => {
          dropdown.open = false;
        }, 160);
      };

      dropdown.addEventListener('pointerenter', scheduleOpen);
      dropdown.addEventListener('pointerleave', scheduleClose);
      dropdown.addEventListener('focusin', scheduleOpen);
      dropdown.addEventListener('focusout', (event) => {
        const related = event.relatedTarget;
        if (related instanceof Node && dropdown.contains(related)) return;
        scheduleClose();
      });

      dropdown.addEventListener('toggle', () => {
        if (!dropdown.open) return;
        closeAllNavDropdowns(dropdown);
      });
    });
  }

  let navGlobalListenersBound = false;
  function bindNavGlobalListeners() {
    if (navGlobalListenersBound) return;
    navGlobalListenersBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      const inside = [...document.querySelectorAll('header .nav-dropdown[open]')].find((dropdown) =>
        dropdown.contains(target),
      );
      if (!inside) closeAllNavDropdowns();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAllNavDropdowns();
    });
  }

  initNavDropdownHover();
  bindNavGlobalListeners();
  document.addEventListener('astro:page-load', () => {
    initNavDropdownHover();
    bindNavGlobalListeners();
  });
</script>

<style>
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav:not([open]) .mobile-nav-panel,
  .mobile-nav:not([open]) .mobile-nav-backdrop {
    display: none;
  }

  .mobile-nav[open] .mobile-nav-backdrop {
    display: block;
  }

  .mobile-nav[open] .mobile-nav-toggle {
    background-color: var(--color-brand-light);
  }

  .mobile-nav[open] .mobile-nav-icon-open {
    display: none;
  }

  .mobile-nav[open] .mobile-nav-icon-close {
    display: block;
  }

  .mobile-nav-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.375rem;
    padding: 0.625rem 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .mobile-nav-link:hover {
    background-color: var(--color-brand-light);
    color: var(--color-primary-dark);
  }

  .mobile-nav-link--active {
    background-color: var(--color-brand-light);
    color: var(--color-accent-on-light);
    font-weight: 600;
  }

  .mobile-nav-link--back {
    margin-bottom: 0.25rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .mobile-nav-section {
    margin-top: 0.5rem;
    border-top: 1px solid #f3f4f6;
    padding-top: 0.75rem;
  }

  .mobile-nav-section-label {
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .mobile-nav-section-links {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-nav-subsection {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 0.25rem;
  }

  .mobile-nav-subsection + .mobile-nav-subsection,
  .mobile-nav-subsection + .mobile-nav-link {
    margin-top: 0.35rem;
  }

  .mobile-nav-subsection-label {
    padding: 0.35rem 0.5rem 0.15rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  .mobile-nav-link--child {
    padding-left: 1rem;
  }
</style>
