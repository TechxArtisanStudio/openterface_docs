{
  "name": "openterface_docs",
  "private": true,
  "type": "module",
  "description": "Openterface documentation hub — docs.openterface.com",
  "scripts": {
    "migrate": "node scripts/migrate-docs-from-legacy.mjs",
    "prebuild": "node scripts/sync-app-versions.mjs",
    "build": "node scripts/build.mjs --i18n=full",
    "build:en": "node scripts/build.mjs --i18n en",
    "build:full": "node scripts/build.mjs --i18n=full --clean",
    "serve": "node scripts/build.mjs --serve",
    "serve:full": "node scripts/build.mjs --serve --i18n=full",
    "i18n:indexes": "node scripts/generate-locale-indexes.mjs",
    "i18n:sync": "node scripts/sync-i18n-config.mjs --full",
    "i18n:audit": "node scripts/i18n/audit.mjs",
    "i18n:audit:strict": "node scripts/i18n/audit.mjs --fail-on-missing --tier-a",
    "validate-links": "node scripts/validate-links.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
