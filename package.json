{
  "name": "openterface_docs",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "siteLocale": "en",
  "description": "Openterface documentation hub — docs.openterface.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/sync-app-versions.mjs && node scripts/generate-sidebar.mjs && node scripts/load-nav-translations.mjs",
    "dev": "astro dev --host --port 4320",
    "serve": "npm run dev",
    "prebuild": "node scripts/sync-app-versions.mjs && node scripts/generate-sidebar.mjs && node scripts/load-nav-translations.mjs",
    "build": "astro build",
    "postbuild": "node scripts/post-build.mjs",
    "preview": "astro preview --port 8000 --host",
    "test:smoke": "playwright test tests/smoke",
    "audit:meta-descriptions": "node scripts/audit-meta-descriptions.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.5",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "mermaid": "^11.15.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "opencc-js": "^1.0.5",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "vite": "7.3.3"
  }
}
